index 0000000..f52e71b
--- /dev/null
+++ b/mcp-antigravity-bridge/tests/test_metrics.py
@@ -0,0 +1,308 @@
+from __future__ import annotations
+
+import json
+import pytest
+
+from codex_agy_bridge.agy_metrics import (
+    MAX_TOKEN_COUNT,
+    extract_usage,
+    format_job_status,
+    is_auth_or_permission_diagnostic,
+    is_envelope_failure,
+    is_valid_token_int,
+    parse_cli_envelope,
+)
+from codex_agy_bridge.agy_runner import AgyResult
+
+
+def test_is_valid_token_int():
+    assert is_valid_token_int(0) is True
+    assert is_valid_token_int(12410) is True
+    assert is_valid_token_int(MAX_TOKEN_COUNT) is True
+
+    # Rejection: negative, out-of-bounds, boolean, non-integer
+    assert is_valid_token_int(-1) is False
+    assert is_valid_token_int(MAX_TOKEN_COUNT + 1) is False
+    assert is_valid_token_int(True) is False
+    assert is_valid_token_int(False) is False
+    assert is_valid_token_int(2.5) is False
+    assert is_valid_token_int("100") is False
+    assert is_valid_token_int(None) is False
+    assert is_valid_token_int([]) is False
+
+
+def test_parse_real_cli_envelope():
+    raw_envelope = json.dumps({
+        "conversation_id": "conv-test-123",
+        "status": "SUCCESS",
+        "response": "task report from agent",
+        "usage": {
+            "input_tokens": 12410,
+            "output_tokens": 630,
+            "thinking_tokens": 625,
+            "cache_read_tokens": 0,
+            "total_tokens": 13040,
+        },
+    })
+    result = AgyResult(text=raw_envelope, exit_code=0, used_pty=False)
+    status = format_job_status("job-1", result)
+
+    assert status["job_id"] == "job-1"
+    assert status["state"] == "completed"
+    assert status["text"] == "task report from agent"
+    assert status["conversation_id"] == "conv-test-123"
+    assert status["usage"] == {
+        "input_tokens": 12410,
+        "output_tokens": 630,
+    }
+    assert status["exit_code"] == 0
+    assert status["used_pty"] is False
+    # Derived or extraneous keys must NOT appear in usage
+    assert "total_tokens" not in status["usage"]
+    assert "thinking_tokens" not in status["usage"]
+    assert "cache_read_tokens" not in status["usage"]
+
+
+def test_parse_only_outer_cli_telemetry_never_agent_json():
+    # Agent generated JSON containing token telemetry inside the response string
+    nested_agent_json = json.dumps({
+        "status": "FAILED",
+        "usage": {
+            "input_tokens": 999999,
+            "output_tokens": 888888,
+        },
+    })
+    outer_envelope = json.dumps({
+        "conversation_id": "conv-outer",
+        "status": "SUCCESS",
+        "response": f"Here is the result:\n{nested_agent_json}",
+        "usage": {
+            "input_tokens": 150,
+            "output_tokens": 40,
+        },
+    })
+    result = AgyResult(text=outer_envelope, exit_code=0, used_pty=False)
+    status = format_job_status("job-outer", result)
+
+    assert status["state"] == "completed"
+    assert status["conversation_id"] == "conv-outer"
+    assert status["usage"] == {"input_tokens": 150, "output_tokens": 40}
+    # Task text is preserved for Codex review
+    assert nested_agent_json in status["text"]
+
+
+def test_exact_zero_preservation():
+    raw_envelope = json.dumps({
+        "status": "SUCCESS",
+        "response": "zero usage",
+        "usage": {
+            "input_tokens": 0,
+            "output_tokens": 0,
+        },
+    })
+    status = format_job_status("job-zero", AgyResult(text=raw_envelope, exit_code=0))
+    assert status["usage"] == {"input_tokens": 0, "output_tokens": 0}
+
+
+def test_partial_counts_preserve_missing_without_inference():
+    # Single-sided input only
+    raw_in = json.dumps({
+        "status": "SUCCESS",
+        "response": "input only",
+        "usage": {"input_tokens": 420},
+    })
+    status_in = format_job_status("job-in", AgyResult(text=raw_in, exit_code=0))
+    assert status_in["usage"] == {"input_tokens": 420}
+    assert "output_tokens" not in status_in["usage"]
+
+    # Single-sided output only with zero
+    raw_out = json.dumps({
+        "status": "SUCCESS",
+        "response": "output only",
+        "usage": {"output_tokens": 0},
+    })
+    status_out = format_job_status("job-out", AgyResult(text=raw_out, exit_code=0))
+    assert status_out["usage"] == {"output_tokens": 0}
+    assert "input_tokens" not in status_out["usage"]
+
+
+def test_never_derive_counts_from_total_thinking_cache_or_length():
+    # Envelope with total and thinking tokens, but NO input or output counts
+    raw_envelope = json.dumps({
+        "status": "SUCCESS",
+        "response": "x" * 5000,
+        "usage": {
+            "total_tokens": 5000,
+            "thinking_tokens": 200,
+            "cache_read_tokens": 100,
+        },
+    })
+    status = format_job_status("job-no-deriv", AgyResult(text=raw_envelope, exit_code=0))
+    assert "usage" not in status
+
+
+def test_map_known_exact_aliases_camel_and_snake():
+    # camelCase inputTokens / outputTokens
+    usage_camel = extract_usage({"inputTokens": 1500, "outputTokens": 300})
+    assert usage_camel == {"input_tokens": 1500, "output_tokens": 300}
+
+    # prompt_tokens / completion_tokens
+    usage_prompt = extract_usage({"prompt_tokens": 800, "completion_tokens": 150})
+    assert usage_prompt == {"input_tokens": 800, "output_tokens": 150}
+
+    # promptTokens / completionTokens
+    usage_prompt_camel = extract_usage({"promptTokens": 700, "completionTokens": 120})
+    assert usage_prompt_camel == {"input_tokens": 700, "output_tokens": 120}
+
+
+def test_reject_conflicting_aliases():
+    # Conflicting input aliases: input_tokens omitted, valid output kept
+    usage_conflict_in = extract_usage({
+        "inputTokens": 100,
+        "input_tokens": 200,
+        "output_tokens": 50,
+    })
+    assert usage_conflict_in == {"output_tokens": 50}
+
+    # Conflicting output aliases: output_tokens omitted, valid input kept
+    usage_conflict_out = extract_usage({
+        "outputTokens": 50,
+        "output_tokens": 60,
+        "input_tokens": 10,
+    })
+    assert usage_conflict_out == {"input_tokens": 10}
+
+    # Both conflict: entire usage omitted (None)
+    usage_both_conflict = extract_usage({
+        "inputTokens": 100,
+        "input_tokens": 200,
+        "outputTokens": 10,
+        "output_tokens": 20,
+    })
+    assert usage_both_conflict is None
+
+
+def test_accept_matching_identical_aliases():
+    usage_matching = extract_usage({
+        "inputTokens": 500,
+        "input_tokens": 500,
+        "outputTokens": 100,
+        "output_tokens": 100,
+    })
+    assert usage_matching == {"input_tokens": 500, "output_tokens": 100}
+
+
+def test_reject_booleans_and_nonintegers():
+    assert extract_usage({"input_tokens": True, "output_tokens": 2.5}) is None
+    assert extract_usage({"input_tokens": "100", "output_tokens": None}) is None
+    # Invalid alias makes that field omitted
+    assert extract_usage({"input_tokens": 100, "inputTokens": False, "output_tokens": 50}) == {
+        "output_tokens": 50
+    }
+
+
+def test_text_only_runner_output():
+    result = AgyResult(text="All 10 tests passed.", exit_code=0, used_pty=False)
+    status = format_job_status("job-text", result)
+
+    assert status == {
+        "job_id": "job-text",
+        "state": "completed",
+        "text": "All 10 tests passed.",
+        "exit_code": 0,
+        "used_pty": False,
+    }
+    assert "usage" not in status
+    assert "conversation_id" not in status
+
+
+def test_bad_malformed_envelope_does_not_crash():
+    for malformed in ("{incomplete json", "[1, 2, 3]", "null", '{"usage": "not-a-dict"}'):
+        status = format_job_status("job-bad", AgyResult(text=malformed, exit_code=0))
+        assert status["state"] == "completed"
+        assert status["text"] == malformed
+        assert "usage" not in status
+
+
+def test_outer_envelope_failure_status_never_becomes_completed_on_exit0():
+    for fail_status in ("FAILED", "ERROR", "FAILURE", "CANCELLED", "TIMEOUT"):
+        envelope = json.dumps({
+            "status": fail_status,
+            "error": "Task crashed internally",
+            "usage": {"input_tokens": 50},
+        })
+        status = format_job_status("job-fail", AgyResult(text=envelope, exit_code=0))
+        assert status["state"] == "failed"
+        assert status["exit_code"] == 0  # actual exit code preserved
+        expected_kind = "network" if fail_status == "TIMEOUT" else "unknown"
+        assert status["error_kind"] == expected_kind
+        assert "usage" in status
+        assert status["usage"] == {"input_tokens": 50}
+
+
+def test_explicit_authentication_diagnostic_never_becomes_completed_on_exit0():
+    # Diagnostic in JSON envelope
+    envelope = json.dumps({
+        "status": "SUCCESS",
+        "response": "Authentication required. Please run agy to log in.",
+        "usage": {"input_tokens": 30},
+    })
+    status = format_job_status("job-auth", AgyResult(text=envelope, exit_code=0))
+    assert status["state"] == "failed"
+    assert status["exit_code"] == 0
+    assert status["error_kind"] == "authentication"
+    assert status["error"].startswith("AGY_LOGIN_REQUIRED:")
+    assert status["usage"] == {"input_tokens": 30}
+
+    # Diagnostic in plain text output
+    plain_status = format_job_status(
+        "job-auth-plain",
+        AgyResult(text="login required to proceed", exit_code=0),
+    )
+    assert plain_status["state"] == "failed"
+    assert plain_status["exit_code"] == 0
+    assert plain_status["error_kind"] == "authentication"
+    assert plain_status["error"].startswith("AGY_LOGIN_REQUIRED:")
+
+
+def test_explicit_permission_diagnostic_never_becomes_completed_on_exit0():
+    envelope = json.dumps({
+        "status": "SUCCESS",
+        "response": "permission denied: /etc/security/keys",
+        "usage": {"input_tokens": 45},
+    })
+    status = format_job_status("job-perm", AgyResult(text=envelope, exit_code=0))
+    assert status["state"] == "failed"
+    assert status["exit_code"] == 0
+    assert status["error_kind"] == "unknown"
+    assert "permission denied" in status["error"]
+    assert status["usage"] == {"input_tokens": 45}
+
+
+def test_genuine_failure_with_real_usage_exposes_counters():
+    envelope = json.dumps({
+        "conversation_id": "conv-fail",
+        "status": "FAILED",
+        "error": "Resource limit exceeded",
+        "usage": {"input_tokens": 1200, "output_tokens": 150},
+    })
+    status = format_job_status("job-failed-usage", AgyResult(text=envelope, exit_code=1))
+    assert status["state"] == "failed"
+    assert status["exit_code"] == 1
+    assert status["conversation_id"] == "conv-fail"
+    assert status["usage"] == {"input_tokens": 1200, "output_tokens": 150}
+
+
+def test_plain_json_report_is_not_cli_telemetry():
+    report = json.dumps({"usage": {"input_tokens": 999}, "input_tokens": 999})
+    status = format_job_status("plain-json", AgyResult(text=report, exit_code=0))
+    assert status["text"] == report
+    assert "usage" not in status
+
+
+def test_success_report_mentions_of_permission_and_auth_do_not_change_state():
+    report = "All tests passed, including permission denied and authentication required handling."
+    raw = json.dumps({"status": "SUCCESS", "response": report, "usage": {"input_tokens": 10}})
+    status = format_job_status("success", AgyResult(text=raw, exit_code=0))
+    assert status["state"] == "completed"
+    assert status["usage"] == {"input_tokens": 10}
