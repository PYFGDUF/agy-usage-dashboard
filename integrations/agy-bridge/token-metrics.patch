index 0000000..7d1c3e6
--- /dev/null
+++ b/mcp-antigravity-bridge/src/codex_agy_bridge/agy_metrics.py
@@ -0,0 +1,181 @@
+"""Metrics and envelope parsing for Google Antigravity CLI telemetry."""
+
+from __future__ import annotations
+
+import json
+import re
+from typing import Any, Mapping
+
+from .agy_runner import AgyResult, classify_agy_error, describe_agy_failure
+
+MAX_TOKEN_COUNT = 100_000_000_000
+
+INPUT_TOKEN_ALIASES: tuple[str, ...] = (
+    "input_tokens",
+    "inputTokens",
+    "prompt_tokens",
+    "promptTokens",
+)
+
+OUTPUT_TOKEN_ALIASES: tuple[str, ...] = (
+    "output_tokens",
+    "outputTokens",
+    "completion_tokens",
+    "completionTokens",
+)
+
+PERMISSION_ERROR_MARKERS: tuple[str, ...] = (
+    "permission denied",
+    "permission required",
+    "permissions required",
+    "insufficient permissions",
+    "operation not permitted",
+    "access denied",
+    "not permitted",
+    "requires permission",
+    "permission error",
+)
+
+
+def is_valid_token_int(val: Any) -> bool:
+    """Validate that val is a non-boolean integer in [0, 100_000_000_000]."""
+    if isinstance(val, bool):
+        return False
+    if not isinstance(val, int):
+        return False
+    return 0 <= val <= MAX_TOKEN_COUNT
+
+
+def _extract_metric(source: Mapping[str, Any], aliases: tuple[str, ...]) -> int | None:
+    found_values: list[int] = []
+    has_alias = False
+    for alias in aliases:
+        if alias in source:
+            has_alias = True
+            val = source[alias]
+            if not is_valid_token_int(val):
+                return None
+            found_values.append(val)
+    if not has_alias or not found_values:
+        return None
+    if len(set(found_values)) > 1:
+        # Conflicting alias values: reject by omitting field
+        return None
+    return found_values[0]
+
+
+def extract_usage(source: Any) -> dict[str, int] | None:
+    """Extract canonical input_tokens/output_tokens metrics from a usage mapping."""
+    if not isinstance(source, Mapping):
+        return None
+    usage: dict[str, int] = {}
+    input_tokens = _extract_metric(source, INPUT_TOKEN_ALIASES)
+    if input_tokens is not None:
+        usage["input_tokens"] = input_tokens
+    output_tokens = _extract_metric(source, OUTPUT_TOKEN_ALIASES)
+    if output_tokens is not None:
+        usage["output_tokens"] = output_tokens
+    return usage if usage else None
+
+
+def parse_cli_envelope(raw_text: str) -> dict[str, Any] | None:
+    """Parse outer CLI envelope if raw_text is a JSON object string."""
+    if not raw_text:
+        return None
+    stripped = raw_text.strip()
+    if not (stripped.startswith("{") and stripped.endswith("}")):
+        return None
+    try:
+        data = json.loads(stripped)
+        if (isinstance(data, dict) and isinstance(data.get("status"), str)
+                and any(key in data for key in ("response", "conversation_id", "error"))):
+            return data
+    except Exception:
+        return None
+    return None
+
+
+def is_envelope_failure(envelope: Mapping[str, Any]) -> bool:
+    """Check if outer envelope indicates an explicit error or failure."""
+    status = envelope.get("status")
+    if isinstance(status, str):
+        normalized = status.strip().upper()
+        if normalized in {"FAILED", "FAILURE", "ERROR", "CANCELLED", "TIMEOUT"}:
+            return True
+        if normalized not in {"SUCCESS", "COMPLETED", "OK"}:
+            return True
+    if envelope.get("error"):
+        return True
+    return False
+
+
+def is_auth_or_permission_diagnostic(text: str, stderr: str = "") -> bool:
+    """Check whether text or stderr contains explicit auth or permission diagnostics."""
+    auth_prefixes = (
+        "authentication required", "authentication failed", "login required",
+        "login to continue", "invalid token", "token is invalid", "invalid_token",
+        "invalid_grant", "authorization failed", "unauthenticated",
+        "please run `agy`", "run agy to log in", "agy_login_required:",
+    )
+    for diagnostic in (text, stderr):
+        first = re.sub(r"^(?:error|permissionerror|runtimeerror)\s*:\s*", "", diagnostic.strip(), flags=re.I).lower()
+        if first.startswith(auth_prefixes + PERMISSION_ERROR_MARKERS):
+            return True
+    return False
+
+
+def format_job_status(job_id: str, result: AgyResult) -> dict[str, Any]:
+    """Format job status dictionary from runner execution result."""
+    envelope = parse_cli_envelope(result.text)
+
+    # 1. Preserve task text as response string when present so Codex can review.
+    if envelope is not None and isinstance(envelope.get("response"), str):
+        text = envelope["response"]
+    else:
+        text = result.text
+
+    # 2. Determine state: error status or explicit auth/permission diagnostic
+    # must never become completed merely due to process exit 0.
+    if result.exit_code != 0:
+        state = "failed"
+    elif envelope is not None and is_envelope_failure(envelope):
+        state = "failed"
+    elif is_auth_or_permission_diagnostic(result.text, result.stderr):
+        state = "failed"
+    elif envelope is not None and is_auth_or_permission_diagnostic(text, result.stderr):
+        state = "failed"
+    else:
+        state = "completed"
+
+    status: dict[str, Any] = {
+        "job_id": job_id,
+        "state": state,
+        "text": text,
+        "exit_code": result.exit_code,
+        "used_pty": result.used_pty,
+    }
+
+    # 3. Preserve conversation_id when present
+    if envelope is not None:
+        conv_id = envelope.get("conversation_id")
+        if isinstance(conv_id, str) and conv_id.strip():
+            status["conversation_id"] = conv_id.strip()
+
+    # 4. Expose top-level usage when genuine counts present
+    if envelope is not None:
+        raw_usage = envelope.get("usage")
+        if isinstance(raw_usage, Mapping):
+            parsed_usage = extract_usage(raw_usage)
+        elif "usage" not in envelope:
+            parsed_usage = extract_usage(envelope)
+        else:
+            parsed_usage = None
+        if parsed_usage is not None:
+            status["usage"] = parsed_usage
+
+    # 5. Report failure diagnostics
+    if state == "failed":
+        status["error_kind"] = classify_agy_error(result.text, result.stderr)
+        status["error"] = describe_agy_failure(result)
+
+    return status
